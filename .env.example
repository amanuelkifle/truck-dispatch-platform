# Copy this file to .env.local for local development, and add the same
# keys as Environment Variables in the Vercel project (never commit real
# values to git).
#
# This project is fully independent from StockIQ: separate database,
# separate auth, separate storage, separate domain.

# --- Database (PostgreSQL - Supabase) ---
DATABASE_URL=

# --- Authentication (Supabase Auth) ---
# Project URL and keys from: Supabase dashboard -> Settings -> API Keys.
# NEXT_PUBLIC_ vars are exposed to the browser - only the anon/publishable
# key belongs there. The service role/secret key must stay server-only and
# NEVER get a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- File storage (rate confirmations, BOLs, PODs, carrier packets) ---
# Uses Supabase Storage in the same project as the database/auth above, so
# no separate credentials are needed - NEXT_PUBLIC_SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY (above) are what the app uses to talk to it.
# Create a PRIVATE bucket with this name in Supabase dashboard -> Storage.
SUPABASE_STORAGE_BUCKET=documents

# --- Maps / routing (mileage, deadhead, ETA - Phase 7) ---
# Free Mapbox account -> https://account.mapbox.com/access-tokens/ ->
# default public token works fine (Geocoding + Directions Matrix are both
# covered by the free tier's 100k requests/month). Server-only - never
# add a NEXT_PUBLIC_ prefix to this one.
MAPBOX_ACCESS_TOKEN=

# --- Background jobs (Inngest / Trigger.dev) ---
BACKGROUND_JOBS_API_KEY=

# --- Notifications ---
# Phase 8 notifications are in-app only for now (computed on each
# dashboard load - see the Dashboard's "Alerts" panel). No email/SMS
# provider is wired up yet, so these two are unused placeholders for a
# later phase.
EMAIL_API_KEY=
SMS_API_KEY=

# --- Contact form notifications (marketing homepage "Contact us") ---
# Free Resend account -> https://resend.com/api-keys. The message is always
# saved to the contact_messages table regardless of these being set - see
# /contact-messages in the app (platform_admin accounts only). Without a
# verified custom domain, RESEND_FROM_EMAIL stays as the default
# onboarding@resend.dev, which can only send TO the email address your
# Resend account itself was signed up with - so set
# CONTACT_NOTIFICATION_EMAIL to that same address for this to work.
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=
CONTACT_FROM_EMAIL=

# --- Billing (Stripe subscriptions) ---
# Test-mode keys from the Stripe dashboard -> Developers -> API keys.
# STRIPE_PRICE_STARTER / STRIPE_PRICE_GROWTH are the Price IDs (price_...)
# of the recurring monthly prices under Product catalog for those two
# plans - Enterprise stays "Contact us" and has no price here.
# STRIPE_WEBHOOK_SECRET comes from Developers -> Webhooks -> your endpoint
# (or from `stripe listen` when testing locally with the Stripe CLI).
# NEXT_PUBLIC_APP_URL is this app's own base URL, used to build Stripe's
# success/cancel/return redirect links (e.g. http://localhost:3000 locally,
# your real domain in production).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
NEXT_PUBLIC_APP_URL=

# --- AI features (document extraction, load scoring, negotiation assistant) ---
# Deferred - Phase 7's load scoring is a plain weighted formula
# (lib/scoring.ts), not AI-based. Unused placeholder for a later phase.
AI_API_KEY=
