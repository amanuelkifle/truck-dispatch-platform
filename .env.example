# Copy this file to .env.local for local development, and add the same
# keys as Environment Variables in the Vercel project (never commit real
# values to git).
#
# This project is fully independent from StockIQ: separate database,
# separate auth, separate storage, separate domain.

# --- Database (PostgreSQL - Supabase) ---
DATABASE_URL=

# --- Authentication (Supabase Auth) ---
# Project URL and keys from: Supabase dashboard -> Settings -> API Keys.
# NEXT_PUBLIC_ vars are exposed to the browser - only the anon/publishable
# key belongs there. The service role/secret key must stay server-only and
# NEVER get a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- File storage (rate confirmations, BOLs, PODs, etc.) ---
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_KEY=
STORAGE_SECRET=

# --- Maps / routing (mileage, deadhead, ETA) ---
MAPS_API_KEY=

# --- Background jobs (Inngest / Trigger.dev) ---
BACKGROUND_JOBS_API_KEY=

# --- Notifications ---
EMAIL_API_KEY=
SMS_API_KEY=

# --- AI features (document extraction, load scoring, negotiation assistant) ---
AI_API_KEY=
