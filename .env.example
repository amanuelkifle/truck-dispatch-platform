# Copy this file to .env.local for local development, and add the same
# keys as Environment Variables in the Vercel project (never commit real
# values to git).
#
# This project is fully independent from StockIQ: separate database,
# separate auth, separate storage, separate domain.

# --- Database (PostgreSQL - Supabase) ---
DATABASE_URL=

# --- Authentication (Supabase Auth) ---
# Project URL and keys from: Supabase dashboard -> Settings -> API Keys.
# NEXT_PUBLIC_ vars are exposed to the browser - only the anon/publishable
# key belongs there. The service role/secret key must stay server-only and
# NEVER get a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- File storage (rate confirmations, BOLs, PODs, carrier packets) ---
# Uses Supabase Storage in the same project as the database/auth above, so
# no separate credentials are needed - NEXT_PUBLIC_SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY (above) are what the app uses to talk to it.
# Create a PRIVATE bucket with this name in Supabase dashboard -> Storage.
SUPABASE_STORAGE_BUCKET=documents

# --- Maps / routing (mileage, deadhead, ETA - Phase 7) ---
# Free Mapbox account -> https://account.mapbox.com/access-tokens/ ->
# default public token works fine (Geocoding + Directions Matrix are both
# covered by the free tier's 100k requests/month). Server-only - never
# add a NEXT_PUBLIC_ prefix to this one.
MAPBOX_ACCESS_TOKEN=

# --- Background jobs (Inngest / Trigger.dev) ---
BACKGROUND_JOBS_API_KEY=

# --- Notifications ---
# Phase 8 notifications are in-app only for now (computed on each
# dashboard load - see the Dashboard's "Alerts" panel). No email/SMS
# provider is wired up yet, so these two are unused placeholders for a
# later phase.
EMAIL_API_KEY=
SMS_API_KEY=

# --- AI features (document extraction, load scoring, negotiation assistant) ---
# Deferred - Phase 7's load scoring is a plain weighted formula
# (lib/scoring.ts), not AI-based. Unused placeholder for a later phase.
AI_API_KEY=
